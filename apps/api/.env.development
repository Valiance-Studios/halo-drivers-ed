# Local development: Postgres from docker-compose.yml (`npm run db:up`) and the Firebase Auth emulator
# (`npm run emulators`). Nothing here is secret. Variables already set in the shell take precedence, which
# is how the tests point the API at their own database and port.
PORT=8081
DATABASE_URL=postgres://hde:hde@localhost:5433/halo_drivers_ed
FIREBASE_PROJECT_ID=demo-halo-drivers-ed
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# The emulators do not issue App Check tokens. Never "off" on Cloud Run: the API refuses to start.
APP_CHECK=off
