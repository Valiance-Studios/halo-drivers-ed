# Staging: the app hosted in the dev Firebase project (https://vs-halo-drivers-ed-dev.web.app). Used by
# `npm run dev:staging` and by deploys, which build with `--mode staging`. Vite loads only this file in
# staging mode, not `.env.production`, so it holds the complete config. These values are compiled into
# the public site anyway; Firebase web config is not secret.
VITE_FIREBASE_API_KEY=AIzaSyA5pqXzkaqezlGfWaNkxxNfy-jZSHhNSQ0
VITE_FIREBASE_AUTH_DOMAIN=vs-halo-drivers-ed-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vs-halo-drivers-ed-dev
VITE_FIREBASE_APP_ID=1:427425852003:web:a28c65cbd2592ab9e6a656
# reCAPTCHA Enterprise site key registered with App Check for this web app (public).
VITE_APPCHECK_SITE_KEY=6LceuCguAAAAAEcLFNpFFM_lbOpYIKKkaCvzF5m7
# Where `npm run dev:staging` proxies `/api`: the deployed API, through Hosting's rewrite. Read only by
# vite.config.ts (no VITE_ prefix), so it is not compiled into the app.
HDE_API_URL=https://vs-halo-drivers-ed-dev.web.app
