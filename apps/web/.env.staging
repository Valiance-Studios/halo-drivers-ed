VITE_FIREBASE_AUTH_DOMAIN=vs-halo-drivers-ed-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vs-halo-drivers-ed-dev
VITE_FIREBASE_APP_ID=1:427425852003:web:a28c65cbd2592ab9e6a656
# reCAPTCHA Enterprise site key registered with App Check for this web app (public). Not created yet:
