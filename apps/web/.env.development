# Development: the local Firebase Auth emulator (`npm run dev`, `npm run emulators`) and the local API,
# which Vite proxies /api to. The `demo-` project keeps the emulators from ever reaching real Firebase
# resources; the emulators accept any API key. The E2E tests use this mode too, with their own emulators.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-halo-drivers-ed.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-halo-drivers-ed
VITE_FIREBASE_APP_ID=demo-app-id
VITE_USE_FIREBASE_EMULATORS=true
